# KHETKOSAATHI — Backend Environment Configuration Example
# Copy this file to .env and provide your authentic credentials.
# NEVER commit your real .env file with secrets to Git.

# --- Supabase Database & Auth (Existing) ---
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_for_server_only"

# Vite client-side mirrors (Public only!)
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your_project.supabase.co"

# --- NASA POWER API ---
# Base endpoint for daily point agrometeorology queries (public point endpoint)
NASA_POWER_BASE_URL="https://power.larc.nasa.gov/api/temporal/daily/point"

# --- NASA Earthdata Credentials (Backend Server Only) ---
# Register free at https://urs.earthdata.nasa.gov/
# Required for NASA GES DISC GPM IMERG and AppEEARS MODIS data downloads.
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""
NASA_EARTHDATA_TOKEN=""

# --- NASA FIRMS Map Key (Backend Server Only) ---
# Obtain your free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Required for active fire and thermal anomaly queries.
NASA_FIRMS_MAP_KEY=""
